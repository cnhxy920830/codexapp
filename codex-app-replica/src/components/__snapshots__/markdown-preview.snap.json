  "notebookDetailsBlocks": "<div class=\"w-[640px] px-4 py-4\"><div class=\"text-size-chat space-y-3\"><details class=\"group my-3 rounded-xl border border-token-border/30 bg-token-bg-secondary/15 px-4 py-3\" open=\"\"><summary class=\"text-size-chat flex cursor-pointer list-none items-center gap-1.5 font-medium text-token-foreground marker:hidden [&amp;::-webkit-details-marker]:hidden\"><svg width=\"20\" height=\"21\" viewBox=\"0 0 20 21\" fill=\"none\" aria-hidden=\"true\" class=\"icon-2xs shrink-0 -rotate-90 text-token-text-tertiary transition-transform group-open:rotate-0\"><path d=\"[path]\" fill=\"currentColor\" stroke=\"currentColor\" stroke-width=\"0.6\"></path></svg><span>Expanded section</span></summary><div class=\"pt-2 [&amp;&gt;*:last-child]:mb-0\"><p class=\"text-[13px] leading-6 text-token-text-primary\">Inspect <button type=\"button\" class=\"cursor-pointer text-left text-[var(--color-link-text)] underline underline-offset-2 transition hover:opacity-80\" title=\"./summary.ipynb:8\">summary.ipynb:8</button> before rerunning the cell.</p><ul class=\"space-y-2 pl-0 text-[13px] leading-6 text-token-text-primary\"><li class=\"list-none\"><div class=\"flex items-start gap-2\"><input class=\"mt-[5px] h-3.5 w-3.5 shrink-0 accent-token-text-primary\" disabled=\"\" readOnly=\"\" type=\"checkbox\" checked=\"\"/><div class=\"min-w-0 flex-1 space-y-2\"><p class=\"text-[13px] leading-6 text-token-text-primary\">keep parity</p></div></div></li></ul></div></details><details class=\"group my-3 rounded-xl border border-token-border/30 bg-token-bg-secondary/15 px-4 py-3\"><summary class=\"text-size-chat flex cursor-pointer list-none items-center gap-1.5 font-medium text-token-foreground marker:hidden [&amp;::-webkit-details-marker]:hidden\"><svg width=\"20\" height=\"21\" viewBox=\"0 0 20 21\" fill=\"none\" aria-hidden=\"true\" class=\"icon-2xs shrink-0 -rotate-90 text-token-text-tertiary transition-transform group-open:rotate-0\"><path d=\"[path]\" fill=\"currentColor