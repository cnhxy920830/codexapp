{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex App Replica",
  "version": "0.1.0",
  "identifier": "com.openai.codex.replica",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex App Replica",
        "width": 1702,
        "height": 962,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "resources": {
      "resources/THIRD_PARTY_NOTICES.txt": "THIRD_PARTY_NOTICES.txt"
    },
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
